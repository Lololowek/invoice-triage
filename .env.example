# OpenAI-compatible endpoint. Ollama: http://localhost:11434/v1 ; vLLM: http://localhost:8000/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5:9b
# Ollama and vLLM ignore the key, but the openai client needs a non-empty string.
LLM_API_KEY=ollama
# json_schema (constrained decoding; OpenAI, vLLM, Ollama) or json_object for providers without schema support
LLM_RESPONSE_FORMAT=json_schema
# Optional JSON merged into the request body, e.g. to turn off a model's thinking mode
# LLM_EXTRA_BODY={"think": false}
LLM_TIMEOUT_S=180
