# OpenAI-compatible endpoint. Ollama: http://localhost:11434/v1 ; vLLM: http://localhost:8000/v1
LLM_BASE_URL=http://localhost:11434/v1
# Built from config/ollama/Modelfile (qwen3.5:4b with fixed context and sampling)
LLM_MODEL=invoice-4b
# Ollama and vLLM ignore the key, but the openai client needs a non-empty string.
LLM_API_KEY=ollama
# json_schema (constrained decoding; OpenAI, vLLM, Ollama) or json_object for providers without it
LLM_RESPONSE_FORMAT=json_schema
# compact: one string per field (default, ~5x fewer output tokens); full: slot objects
LLM_ANSWER_FORMAT=compact
# Turns off Qwen3.5 thinking through Ollama's OpenAI endpoint ("think": false is ignored there).
# Measured on "17 + 25": 81 s / 633 tokens with thinking, 1.8 s / 12 tokens without.
LLM_EXTRA_BODY={"reasoning_effort": "none"}
LLM_TIMEOUT_S=600

# API (triage serve). llm = the model above; oracle = gold annotation, synthetic invoices only.
TRIAGE_MAPPER=llm
TRIAGE_DB=triage.sqlite3
